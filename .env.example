# SMTP host from your mailbox provider.
# For cPanel this is often something like: mail.3pdigital.com.au
SMTP_HOST=mail.3pdigital.com.au

# SMTP port:
# 465 for SSL/TLS, or 587 for STARTTLS.
SMTP_PORT=465

# Whether the SMTP connection is secure.
# Use true with port 465, false with port 587.
SMTP_SECURE=true

# Full mailbox username for the sending account.
# Example: forms@3pdigital.com.au
SMTP_USER=forms@3pdigital.com.au

# Mailbox password for the sending account.
SMTP_PASS=replace-with-mailbox-password

# "From" address shown on outgoing emails.
# This can use a Moore Consultants display name even if the mailbox domain is 3pdigital.com.au.
# Example: Moore Consultants <forms@3pdigital.com.au>
SMTP_FROM_EMAIL=Moore Consultants <forms@3pdigital.com.au>
